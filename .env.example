# Optional detector estimate provider. The app does not guarantee or optimize for a detector score.
GPTZERO_API_KEY=

# Optional payments and email.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=

# Set this only after choosing an admin bootstrap token.
ADMIN_BOOTSTRAP_TOKEN=

# Promotional balance granted once per account each ISO week; set to 0 to disable.
WEEKLY_FREE_CREDITS=500
