APP_ENV=development
APP_SECRET=replace-with-a-long-random-secret
APP_URL=http://localhost:8000
DATABASE_URL=sqlite:///./txtzi.db

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
XAI_API_KEY=
